# Pull your pre-built Quarkus application image from Docker Hub
FROM sreedockerhub19/my-quarkus-java-app:latest

# Tell Vercel's edge network to route traffic to Port 80
ENV PORT=80
EXPOSE $PORT

# THE QUARKUS CHEAT CODE:
# Quarkus natively listens to these environment variables.
# We force it to drop 8080 and bind to Vercel's Port 80 on all network interfaces (0.0.0.0).
ENV QUARKUS_HTTP_PORT=80
ENV QUARKUS_HTTP_HOST=0.0.0.0

# No socat, no absolute paths, no shell scripts!
# Vercel will just naturally execute your base image's CMD ["java", "-jar", "quarkus-run.jar"]