# Pull your pre-built Ktor application image from Docker Hub
FROM sreedockerhub19/my-ktor-app:latest

# Set Vercel's dynamic runtime port environment variable
ENV PORT=80
EXPOSE $PORT

# Reinforce the Java environments so they aren't stripped during the pipeline build
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Override the original entrypoint using a shell execution setup.
# This forces Ktor to bind to Vercel's dynamic $PORT engine allocations.
ENTRYPOINT ["/bin/sh", "-c", "java -Dktor.deployment.port=$PORT -Dserver.port=$PORT -jar app.jar"]