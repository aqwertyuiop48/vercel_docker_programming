# Pull your pre-built Ktor application image from Docker Hub
FROM sreedockerhub19/my-ktor-app:latest

# Set Vercel's dynamic runtime port environment variable
ENV PORT=80
EXPOSE $PORT

# Force clear binary paths 
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Force the container to use the explicit working directory
WORKDIR /app

# Absolute system paths for execution to prevent runtime path shifts.
# We explicitly bind to host 0.0.0.0 so Vercel's proxy router can reach the container.
ENTRYPOINT ["/bin/sh", "-c", "/opt/java/openjdk/bin/java -Dktor.deployment.port=$PORT -Dktor.deployment.host=0.0.0.0 -jar /app/app.jar"]