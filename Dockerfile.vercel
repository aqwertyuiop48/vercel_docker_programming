# Pull your pre-built Quarkus Kotlin application image
FROM sreedockerhub19/my-quarkus-kotlin-app:latest

# Tell Vercel's edge network to route traffic to Port 80
ENV PORT=80
EXPOSE $PORT

# THE QUARKUS CHEAT CODE:
# Quarkus natively listens to these variables. 
# It drops 8080 and binds instantly to Vercel's edge network on all interfaces.
ENV QUARKUS_HTTP_PORT=80
ENV QUARKUS_HTTP_HOST=0.0.0.0

# Mirror the Java paths from Layer 3 & 4 to override Vercel's PATH-stripping bug
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# THE FIX (Bypassing Layer 11):
# We explicitly override the hidden /__cacert_entrypoint.sh script.
# By using the absolute path to Java, Vercel perfectly executes Layer 15's command.
ENTRYPOINT ["/opt/java/openjdk/bin/java", "-jar", "/app/quarkus-run.jar"]