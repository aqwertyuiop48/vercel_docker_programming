# Pull your pre-built Spring Boot application image
FROM sreedockerhub19/my-spring-boot-maven-app:latest

# Set up Vercel's required edge port
ENV PORT=80
EXPOSE $PORT

# THE SPRING BOOT CHEAT CODE:
# Spring Boot natively listens to these environment variables.
# This forces the internal Tomcat server to drop 8080 and bind cleanly to Vercel's Port 80.
ENV SERVER_PORT=80
ENV SERVER_ADDRESS=0.0.0.0

# Mirror the Java paths to enforce them in the environment
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# THE FIX:
# 1. Bypass the hidden Eclipse Temurin entrypoint using the absolute Java path to prevent "java: not found".
# 2. Add JVM fast-boot flags (-noverify, TieredCompilation) to guarantee Spring Boot beats Vercel's strict 15-second timeout.
ENTRYPOINT ["/opt/java/openjdk/bin/java", "-noverify", "-XX:+TieredCompilation", "-XX:TieredStopAtLevel=1", "-jar", "/app/app.jar"]