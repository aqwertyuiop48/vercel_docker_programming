FROM sreedockerhub19/my-ktor-app:latest

ENV PORT=80
EXPOSE $PORT

# Force the PATH just in case it was stripped
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Explicitly ensure the execution starts where the jar was copied (/app)
WORKDIR /app

# Emulate your exact working Micronaut structure, adding Ktor specific flags
ENTRYPOINT ["sh", "-c", "/opt/java/openjdk/bin/java -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -Dserver.port=$PORT -Dktor.deployment.port=$PORT -Dktor.deployment.host=0.0.0.0 -jar app.jar"]