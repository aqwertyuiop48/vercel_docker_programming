FROM sreedockerhub19/my-ktor-app:latest

ENV PORT=80
EXPOSE $PORT

# Force the PATH just in case it was stripped
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Explicitly ensure the execution starts where the jar was copied
WORKDIR /app

# Moving the port configurations to the END of the line as application arguments
ENTRYPOINT ["sh", "-c", "/opt/java/openjdk/bin/java -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -jar app.jar -port=$PORT -host=0.0.0.0 -P:ktor.deployment.port=$PORT"]