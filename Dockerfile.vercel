# Pull your pre-built Kotlin HTTP server image
FROM sreedockerhub19/simple-http-server-kotlin:latest

# Switch to root to install our bulletproof proxy
USER root
RUN apt-get update && apt-get install -y socat && rm -rf /var/lib/apt/lists/*

# Set up Vercel's required edge port
ENV PORT=80
EXPOSE $PORT

# Mirror the Java paths to override the Vercel PATH bug
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
WORKDIR /app

# THE BUFFER HACK:
# 1. socat instantly binds to Port 80 to disarm Vercel's 15-second executioner.
# 2. It holds any incoming web requests and retries sending them to 8080 every 1 second.
# 3. We use the absolute path to Java to bypass the broken certificate script in Layer 15.
# 4. We execute your specific main class exactly as defined in your base image's CMD.
ENTRYPOINT ["sh", "-c", "socat TCP-LISTEN:$PORT,fork,reuseaddr TCP:127.0.0.1:8080,retry=30,interval=1 & \
    exec /opt/java/openjdk/bin/java -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -cp app.jar com.example.SimpleHttpServer"]