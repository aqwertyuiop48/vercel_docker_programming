# Pull your pre-built Vert.x application image
FROM sreedockerhub19/my-vertx-app:latest

# Switch to root to install our routing tools
USER root
RUN apt-get update && apt-get install -y socat netcat-openbsd && rm -rf /var/lib/apt/lists/*

ENV PORT=80
EXPOSE 80

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
WORKDIR /app

# THE STABILIZED RELAY:
# 1. Run Java purely. NO aggressive JVM flags. Let Vert.x boot naturally.
# 2. Use 'localhost' instead of 127.0.0.1 to avoid IPv4/IPv6 mismatches.
# 3. Add 'sleep 1' after the port opens to let Netty's event loop fully stabilize.
ENTRYPOINT ["sh", "-c", "/opt/java/openjdk/bin/java -jar /app/app.jar & \
    while ! nc -z localhost 8080; do sleep 0.2; done; \
    sleep 1; \
    exec socat TCP-LISTEN:$PORT,fork,reuseaddr TCP:localhost:8080"]