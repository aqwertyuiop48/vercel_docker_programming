# Pull your pre-built Ruby application image
FROM sreedockerhub19/ruby-http-server:latest

# Switch to root to install socat for routing
USER root
RUN apt-get update && apt-get install -y socat && rm -rf /var/lib/apt/lists/*

# Set up Vercel's required edge port
ENV PORT=80
EXPOSE $PORT

WORKDIR /app

# THE RUBY RELAY:
# 1. Start your Ruby script in the background (&) exactly as defined in Layer 19 (server_.rb).
# 2. Wait a split second (sleep 0.2) since Ruby boots up almost instantly.
# 3. Exec socat to cleanly route incoming traffic from Vercel's $PORT (80) straight to internal port 10000.
ENTRYPOINT ["sh", "-c", "ruby server_.rb & sleep 0.2 && exec socat TCP-LISTEN:$PORT,fork,reuseaddr TCP:127.0.0.1:10000"]