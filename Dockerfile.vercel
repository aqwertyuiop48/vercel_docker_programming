FROM sreedockerhub19/my-ktor-app:latest

# Switch to root to install socat and bind ports
USER root

# Install socat safely
RUN apt-get update && apt-get install -y socat && rm -rf /var/lib/apt/lists/*

ENV PORT=80
EXPOSE $PORT

# Mirror your exact working environment variables
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
WORKDIR /app

# THE FIX: Use the absolute path to the java binary, just like the Micronaut config
ENTRYPOINT ["sh", "-c", "socat TCP-LISTEN:$PORT,fork TCP:127.0.0.1:8080 & /opt/java/openjdk/bin/java -jar app.jar"]