# Pull your pre-built Vert.x application image
FROM sreedockerhub19/my-vertx-app:latest

# Tell Vercel AND Vert.x to use Port 80
ENV PORT=80
EXPOSE 80

# Mirror the Java paths to override the Vercel PATH bug
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Run Vert.x natively using the absolute Java path to bypass Layer 15.
# Vert.x will naturally read ENV PORT=80 and bind beautifully to Vercel's edge network.
ENTRYPOINT ["/opt/java/openjdk/bin/java", "-jar", "/app/app.jar"]