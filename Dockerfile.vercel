FROM sreedockerhub19/my-spring-app:latest

# Switch to root to install socat
USER root
RUN apt-get update && apt-get install -y socat && rm -rf /var/lib/apt/lists/*

ENV PORT=80
EXPOSE $PORT

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
WORKDIR /app

# THE BUFFER HACK:
# 1. socat runs in the background. It BINDS IMMEDIATELY to Vercel's Port 80.
# 2. When Vercel sends traffic, socat accepts it, then tries to forward to 8080.
# 3. If 8080 is down, 'retry=30,interval=1' tells socat to HOLD the Vercel connection and retry every 1s for 30s.
# 4. Java runs in the foreground. Once Tomcat opens 8080 (even if it takes 25s), socat pushes the queued request through.
ENTRYPOINT ["sh", "-c", "socat TCP-LISTEN:$PORT,fork,reuseaddr TCP:127.0.0.1:8080,retry=30,interval=1 & \
    exec /opt/java/openjdk/bin/java -noverify -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -Dspring.main.lazy-initialization=true -jar app.jar"]