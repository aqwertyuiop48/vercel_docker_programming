# Pull your pre-built Quarkus application image
FROM sreedockerhub19/my-quarkus-java-app:latest

# Set up Vercel's required edge port
ENV PORT=80
EXPOSE $PORT

# THE QUARKUS CHEAT CODE:
ENV QUARKUS_HTTP_PORT=80
ENV QUARKUS_HTTP_HOST=0.0.0.0

# Mirror the Java paths to enforce them in the environment
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# THE FIX:
# We explicitly override the base image's hidden entrypoint.
# By using the absolute path to Java, we bypass Vercel's PATH-stripping bug entirely.
ENTRYPOINT ["/opt/java/openjdk/bin/java", "-jar", "/app/quarkus-run.jar"]