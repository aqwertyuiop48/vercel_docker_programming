FROM sreedockerhub19/my-spring-boot-maven-app:latest

# Switch to root to install our network routing tools
USER root
RUN apt-get update && apt-get install -y socat netcat-openbsd && rm -rf /var/lib/apt/lists/*

ENV PORT=80
EXPOSE $PORT

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
WORKDIR /app

# THE FIX: We added "-Dspring.main.lazy-initialization=true"
# This forces Spring Boot to skip loading Hikari on boot, allowing Tomcat to open 8080 in < 5 seconds.
ENTRYPOINT ["sh", "-c", "/opt/java/openjdk/bin/java -noverify -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -Dspring.main.lazy-initialization=true -jar app.jar & \
    while ! nc -z 127.0.0.1 8080; do sleep 0.2; done; \
    exec socat TCP-LISTEN:$PORT,fork,reuseaddr TCP:127.0.0.1:8080"]