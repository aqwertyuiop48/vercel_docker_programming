{
  "version": 2,
    "git": {
    "deploymentEnabled": {
      "helidon-demo-kotlin": true,
      "*": false
    }
  },
  "builds": [
    {
      "src": "Dockerfile.vercel",
      "use": "@vercel/container"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/Dockerfile.vercel"
    }
  ]
}