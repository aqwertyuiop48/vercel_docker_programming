{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "micronaut-kotlin": true,
      "*": false
    }
  },
    "ignoreBuildCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"micronaut-kotlin\" ]",
  "builds": [
    {
      "src": "Dockerfile.vercel",
      "use": "@vercel/container"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
